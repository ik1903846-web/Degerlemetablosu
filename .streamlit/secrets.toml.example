# Streamlit Cloud Secrets Template
# Copy this to .streamlit/secrets.toml (LOCAL test) or paste into
# Streamlit Cloud > Settings > Secrets (PRODUCTION)
#
# Bu dosya sadece template — secrets.toml gitignore'da, asla commit etme.

[auth]
# 16-char random password (Faz 10 ADIM 1.C ile generate edilir)
password = "REPLACE_ME_RANDOM_16CHAR"

[telegram]
# Faz 10 ADIM 6 (Telegram bot alert) için
bot_token = ""
chat_id = ""
